{
  "name": "freelancer-notebook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:validate": "pnpm --filter database db:validate",
    "db:migrate:deploy": "pnpm --filter database db:migrate:deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "date-fns": "3.6.0",
    "lodash": "^4.18.1"
  }
}
