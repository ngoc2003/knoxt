{
  "name": "freelancer-notebook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:validate": "pnpm --filter database db:validate",
    "db:migrate:deploy": "pnpm --filter database db:migrate:deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "date-fns": "3.6.0",
    "lodash": "^4.18.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "lodash": "4.18.1",
      "picomatch@>=4.0.0": "4.0.4",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "vite": "6.4.3",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono@<4.12.25": "4.12.25",
      "multer@>=1.0.0 <2.2.0": "2.2.0",
      "undici@>=7.0.0 <7.28.0": "7.28.0"
    }
  }
}
