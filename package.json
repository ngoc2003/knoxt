{
  "name": "freelancer-notebook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:migrate:deploy": "pnpm --filter database db:migrate:deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "date-fns": "3.6.0",
    "lodash": "^4.18.1"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "vite": "6.3.5"
    }
  }
}
