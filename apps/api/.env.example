DATABASE_URL="postgresql://username:password@localhost:5432/freelancer_notebook"
JWT_SECRET="replace_me"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your_google_oauth_web_client_id.apps.googleusercontent.com"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
WEB_URL="http://localhost:5173"

# Gmail SMTP: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your@gmail.com"
SMTP_PASS="your_16_character_app_password"
SMTP_FROM="Knoxt.io <your@gmail.com>"

# Meeting Intelligence MVP: defaults to stub when omitted
AI_PROVIDER="stub"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
