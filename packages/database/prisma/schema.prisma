generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Priority {
  low
  medium
  high
}

enum CustomerStatus {
  active
  inactive
}

enum ProjectRole {
  viewer
  editor
  admin
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived
}

enum NotePermission {
  viewer
  editor
}

enum DecisionStatus {
  proposed
  accepted
  superseded
  rejected
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
}

enum ActionItemStatus {
  open
  completed
  cancelled
}

enum RequirementPriority {
  low
  medium
  high
  critical
}

enum RequirementStatus {
  draft
  approved
  implemented
  rejected
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  passwordHash           String?
  googleSubject          String?             @unique
  name                   String
  avatarUrl              String?
  settings               Settings?
  customers              Customer[]
  projects               Project[]
  projectMemberships     ProjectMember[]
  sentProjectInvitations ProjectInvitation[] @relation("ProjectInvitationSender")
  tasks                  Task[]              @relation("CreatedTasks")
  assignedTasks          Task[]              @relation("AssignedTasks")
  notes                  Note[]
  sharedNotes            NoteShare[]
  notePins               NotePin[]
  noteTags               NoteTag[]
  aiSessions             AiSession[]
  activityLogs           ActivityLog[]
  decisions              Decision[]           @relation("DecisionCreator")
  meetings               Meeting[]            @relation("MeetingCreator")
  meetingParticipants    MeetingParticipant[]
  actionItemsCreated     ActionItem[]          @relation("ActionItemCreator")
  actionItemsAssigned    ActionItem[]          @relation("ActionItemAssignee")
  requirements           Requirement[]        @relation("RequirementCreator")
  notifications          Notification[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
}

model Settings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  theme     String?
  locale    String?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  name      String
  email     String?
  phone     String?
  company   String?
  status    CustomerStatus @default(active)
  projects  Project[]
  notes     Note[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
}

model Project {
  id          String              @id @default(uuid())
  userId      String
  customerId  String?
  user        User                @relation(fields: [userId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  name        String
  description String?
  status      ProjectStatus       @default(active)
  startDate   DateTime?
  endDate     DateTime?
  tasks       Task[]
  notes       Note[]
  columns     ProjectColumn[]
  members     ProjectMember[]
  invitations ProjectInvitation[]
  decisions   Decision[]
  meetings    Meeting[]
  requirements Requirement[]
  activityLogs ActivityLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([userId, status, updatedAt])
  @@index([status, updatedAt])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(viewer)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id          String      @id @default(uuid())
  projectId   String
  invitedById String
  email       String
  token       String      @unique @default(uuid())
  role        ProjectRole @default(viewer)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("ProjectInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, email])
  @@index([email])
}

model ProjectColumn {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, key])
  @@unique([projectId, name])
  @@index([projectId, orderIndex])
}

model Task {
  id          String        @id @default(uuid())
  userId      String
  projectId   String
  assigneeId  String?
  user        User          @relation("CreatedTasks", fields: [userId], references: [id])
  assignee    User?         @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  project     Project       @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      String        @default("todo")
  priority    Priority      @default(medium)
  orderKey    String        @db.VarChar(16)
  dueDate     DateTime?
  tags        TaskTagMap[]
  timeLogs    TaskTimeLog[]
  promotedFrom ActionItem?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([assigneeId])
  @@index([projectId, status, orderKey])
}

model TaskTag {
  id        String       @id @default(uuid())
  userId    String
  name      String
  color     String?
  tasks     TaskTagMap[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TaskTagMap {
  taskId String
  tagId  String
  task   Task    @relation(fields: [taskId], references: [id])
  tag    TaskTag @relation(fields: [tagId], references: [id])

  @@id([taskId, tagId])
}

model TaskTimeLog {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  duration  Int?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Note {
  id          String          @id @default(uuid())
  userId      String
  projectId   String?
  customerId  String?
  parentId    String?
  user        User            @relation(fields: [userId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer    Customer?       @relation(fields: [customerId], references: [id])
  parent      Note?           @relation("NoteTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Note[]          @relation("NoteTree")
  title       String
  content     String
  position    Int             @default(0)
  version     Int             @default(1)
  tags        NoteTagMap[]
  attachments Attachment[]
  shares      NoteShare[]
  pins        NotePin[]
  publicLink  NotePublicLink?
  sourceDecisions Decision[]
  sourceMeetings Meeting[]
  sourceRequirements Requirement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([projectId, parentId, position])
  @@index([projectId, updatedAt])
  @@index([projectId, deletedAt])
}

model NotePin {
  noteId    String
  userId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([noteId, userId])
  @@index([userId, createdAt])
}

model NoteShare {
  id              String         @id @default(uuid())
  noteId          String
  userId          String
  sourceNoteId    String
  permission      NotePermission @default(viewer)
  includeChildren Boolean        @default(false)
  note            Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([noteId, userId, sourceNoteId])
  @@index([userId])
  @@index([sourceNoteId, userId])
}

model NotePublicLink {
  id              String    @id @default(uuid())
  noteId          String    @unique
  note            Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  includeChildren Boolean   @default(false)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model NoteTag {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  notes     NoteTagMap[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, name])
}

model NoteTagMap {
  noteId String
  tagId  String
  note   Note    @relation(fields: [noteId], references: [id])
  tag    NoteTag @relation(fields: [tagId], references: [id])

  @@id([noteId, tagId])
}

model Attachment {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id])
  url       String
  filename  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decision {
  id           String         @id @default(uuid())
  projectId    String
  createdById  String
  sourceNoteId String?
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("DecisionCreator", fields: [createdById], references: [id])
  sourceNote   Note?          @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  title        String
  description  String
  reason       String?
  impact       String?
  decidedAt    DateTime?
  status       DecisionStatus @default(proposed)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([projectId, deletedAt, updatedAt])
  @@index([projectId, status, decidedAt])
  @@index([sourceNoteId])
}

model Meeting {
  id           String               @id @default(uuid())
  projectId    String
  createdById  String
  sourceNoteId String?
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  sourceNote   Note?                @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  title        String
  scheduledAt  DateTime
  summary      String?
  recordingUrl String?
  status       MeetingStatus        @default(scheduled)
  participants MeetingParticipant[]
  actionItems  ActionItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?

  @@index([projectId, deletedAt, scheduledAt])
  @@index([projectId, status, scheduledAt])
  @@index([sourceNoteId])
}

model MeetingParticipant {
  id            String   @id @default(uuid())
  meetingId     String
  userId        String?
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalName  String?
  externalEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model ActionItem {
  id                   String           @id @default(uuid())
  meetingId            String
  createdById          String
  assigneeId           String?
  promotedTaskId       String?          @unique
  meeting              Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy            User             @relation("ActionItemCreator", fields: [createdById], references: [id])
  assignee             User?            @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  promotedTask         Task?            @relation(fields: [promotedTaskId], references: [id], onDelete: SetNull)
  externalAssigneeName String?
  title                String
  description          String?
  dueDate              DateTime?
  status               ActionItemStatus @default(open)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  @@index([meetingId, deletedAt, createdAt])
  @@index([assigneeId, status, dueDate])
}

model Requirement {
  id           String              @id @default(uuid())
  projectId    String
  createdById  String
  sourceNoteId String?
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("RequirementCreator", fields: [createdById], references: [id])
  sourceNote   Note?               @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  title        String
  description  String
  priority     RequirementPriority @default(medium)
  status       RequirementStatus   @default(draft)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@index([projectId, deletedAt, updatedAt])
  @@index([projectId, status, priority])
  @@index([sourceNoteId])
}

model AiSession {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id        String    @id @default(uuid())
  sessionId String
  session   AiSession @relation(fields: [sessionId], references: [id])
  role      String
  content   String
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
